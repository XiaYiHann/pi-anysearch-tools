{
  "name": "pi-anysearch-tools",
  "version": "0.2.0",
  "description": "AnySearch web search toolset for the Pi coding agent: anysearch_search, anysearch (1-5 queries), anysearch_extract, and anysearch_get_sub_domains tools on the official /mcp JSON-RPC API, anonymous fallback, interactive API key setup (/anysearch-setup). Uses https://api.anysearch.com/mcp.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "web-search",
    "anysearch"
  ],
  "license": "MIT",
  "author": {
    "name": "xyh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XiaYiHann/pi-anysearch-tools.git"
  },
  "files": [
    "*.ts",
    "scripts/",
    "README.md",
    ".env.example",
    "banner.png"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/XiaYiHann/pi-anysearch-tools/main/banner.png"
  }
}
